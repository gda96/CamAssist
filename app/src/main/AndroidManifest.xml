<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Основные разрешения для работы приложения -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    
    <!-- Разрешения для Android Auto (могут быть полезны для совместимости) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- Разрешения для работы в фоновом режиме (для Android Auto) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Разрешения для работы с Bluetooth (может потребоваться для Android Auto) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    
    <!-- Разрешения для работы с местоположением (может потребоваться для Android Auto) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />

    <!-- Queries для Android Auto (обязательно для Android 11+) -->
    <!-- Для Android 16+ и Android Auto 15.7+ требуется полная конфигурация -->
    <queries>
        <!-- Пакет Android Auto -->
        <package android:name="com.google.android.projection.gearhead" />
        <!-- Intent для CarAppService -->
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cam_assist"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">
        
        <!-- Метаданные для распознавания как приложение из Play Store -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cam_assist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Android Auto -->
        <!-- Для Android 16+ и Android Auto 15.7+ требуется полная конфигурация -->
        <!-- Конфигурация для распознавания как приложение из Play Store -->
        <service
            android:name=".car.CarAppService"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
            </intent-filter>
            <!-- Минимальный уровень API для Android Auto -->
            <!-- Для Android Auto 15.7+ рекомендуется использовать уровень 2+ -->
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="2" />
            <!-- Категория приложения для Android Auto -->
            <meta-data
                android:name="androidx.car.app.category"
                android:value="PRODUCTIVITY" />
            <!-- Дополнительные метаданные для Android Auto -->
            <meta-data
                android:name="com.google.android.gms.car.application"
                android:resource="@xml/automotive_app_desc" />
            <!-- Описание приложения для Android Auto -->
            <meta-data
                android:name="androidx.car.app.description"
                android:value="@string/car_app_description" />
            <!-- Иконка приложения для Android Auto -->
            <meta-data
                android:name="androidx.car.app.icon"
                android:resource="@mipmap/ic_launcher" />
            <!-- Дополнительные метаданные для Android 16+ и Android Auto 15.7+ -->
            <meta-data
                android:name="androidx.car.app.template"
                android:value="true" />
        </service>
    </application>

</manifest>